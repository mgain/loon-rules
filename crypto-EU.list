# Crypto EU services, maintained by hand (no upstream to sync from)
# Kraken — MetaCubeX kraken.yaml，只有 2 条
DOMAIN-SUFFIX,kraken.com
DOMAIN-SUFFIX,kraken.onl
# Krak — Kraken 的 P2P 支付 App，没有现成规则集
DOMAIN-SUFFIX,krak.app
# Bybit EU — 独立的 MiCA 平台，不在 MetaCubeX bybit.yaml（16 条全球版）里
DOMAIN-SUFFIX,bybit.eu
# Ether.fi — 流动性质押 / Cash 卡
DOMAIN-SUFFIX,ether.fi
# Pulsar Finance — 跨链投资组合追踪（现为 Shotgun 交易终端）
DOMAIN-SUFFIX,pulsar.finance
# Shotgun — Pulsar 团队的 Solana 交易终端
DOMAIN-SUFFIX,shotgun.fun
# MetaMask — 无单独规则集，合集里只有 metamask.io
DOMAIN-SUFFIX,metamask.io
# Infura — MetaMask 默认 RPC 节点（ConsenSys）
DOMAIN-SUFFIX,infura.io
